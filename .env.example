# ============================================================
# The Content Machine — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── LLM Configuration (Google Gemini) ─────────────────────
LLM_API_KEY=                  # Your Gemini API key (NEVER commit this)
LLM_MODEL=gemini-2.5-pro     # Model: gemini-2.5-pro, gemini-2.5-flash

# ─── Agent Identity ────────────────────────────────────────
AGENT_NAME=content-machine
AGENT_DESCRIPTION=AI-powered content operations agent — trend monitoring, multi-platform content generation, scheduling, and brand voice management.
AGENT_WALLET_ADDRESS=erd1...  # Your MultiversX wallet address

# ─── Pricing ───────────────────────────────────────────────
PRICE_PER_QUERY=0.10
PRICE_TOKEN=USDC-350c4e

# ─── External APIs ─────────────────────────────────────────
SEARCH_API_KEY=               # Optional: for monitor_feeds web search
IMAGE_API_KEY=                # Optional: Gemini image generation for thumbnails

# ─── Auth ──────────────────────────────────────────────────
AUTH_TOKEN_SECRET=            # HMAC secret for bearer tokens (auto-generated if empty)

# ─── Server ────────────────────────────────────────────────
BACKEND_PORT=4000
CORS_ORIGIN=                  # Leave empty for dev (allows all)
NODE_ENV=development

# ─── MultiversX Network ───────────────────────────────────
MULTIVERSX_API_URL=https://devnet-api.multiversx.com
MULTIVERSX_GATEWAY_URL=https://devnet-gateway.multiversx.com
CHAIN_ID=D
IDENTITY_REGISTRY_ADDRESS=erd1qqqqqqqqqqqqqqqpgqhe8t5jewej70zupmh44jurgn29psua5l2jps3ntjj3
